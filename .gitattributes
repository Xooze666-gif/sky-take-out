# 统一换行符：仓库内一律存 LF，检出时按平台自动转换
# 避免 Windows/Linux 协作时整片文件 diff
* text=auto eol=lf

# 源码与配置
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.css    text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 解析会出错
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.jar    binary
*.xlsx   binary
*.docx   binary
